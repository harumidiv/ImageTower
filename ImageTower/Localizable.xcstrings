    "写真の解析に失敗しました。別の写真をお試しください": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'ha pogut analitzar la foto. Prova'n una altra"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotku se nepodařilo analyzovat. Zkus jinou"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Billedet kunne ikke analyseres. Prøv et andet billede"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto konnte nicht analysiert werden. Probier ein anderes."
