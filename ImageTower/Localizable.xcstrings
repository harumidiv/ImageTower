    "どのステージにも使われていません。削除すると元に戻せません。": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'utilitza en cap pantalla. L'eliminació no es pot desfer."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Není použito v žádné úrovni. Smazání nelze vrátit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruges ikke i nogen bane. Sletning kan ikke fortrydes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird in keinem Level verwendet. Das kann nicht widerrufen werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν χρησιμοποιείται σε καμία πίστα. Η διαγραφή δεν αναιρείται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not used in any stage. This can't be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se usa en ningún escenario. Si lo eliminas, no podrás recuperarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei käytössä missään kentässä. Poistoa ei voi kumota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé dans aucun niveau. Cette action est irréversible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी स्टेज में उपयोग नहीं हो रहा। डिलीट करने के बाद वापस नहीं ला सकते।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne koristi se ni u jednoj etapi. Brisanje se ne može poništiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyik pálya sem használja. A törlés nem vonható vissza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dipakai di stage mana pun. Penghapusan tidak bisa dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è usato in nessuno scenario. L'eliminazione è definitiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのステージにも使われていません。削除すると元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 스테이지에도 사용되지 않았어요. 삭제하면 되돌릴 수 없어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak digunakan dalam mana-mana pentas. Pemadaman tidak boleh dibuat asal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Brukes ikke i noen bane. Sletting kan ikke angres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet gebruikt in een level. Verwijderen kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieużywany w żadnym poziomie. Usunięcia nie można cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é usado em nenhuma fase. Se apagar, não será possível desfazer."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é usado em nenhuma fase. Se o apagares, não é possível desfazer."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu e folosită în nicio etapă. Ștergerea nu poate fi anulată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не используется ни в одном уровне. Удаление нельзя отменить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie je použité v žiadnej úrovni. Vymazanie sa nedá vrátiť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Används inte i någon bana. Det går inte att ångra."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ได้ใช้ในด่านใดเลย หากลบจะเลิกทำไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir bölümde kullanılmıyor. Silme işlemi geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не використовується в жодному рівні. Видалення не можна скасувати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa dùng trong màn nào. Xóa rồi sẽ không hoàn tác được."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未用於任何關卡。刪除後無法復原。"
          }
        }
      }
    },
