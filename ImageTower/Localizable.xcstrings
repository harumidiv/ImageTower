        }
      }
    },
    "共有できるのは素材が%lld個以上のステージです。": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només pots compartir pantalles amb %lld retalls o més."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sdílet lze úrovně s aspoň %lld předměty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun baner med mindst %lld objekter kan deles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Levels mit mindestens %lld Elementen können geteilt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείς να μοιραστείς μόνο πίστες με τουλάχιστον %lld κομμάτια."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only stages with %lld or more items can be shared."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se pueden compartir escenarios con %lld recortes o más."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain kentät, joissa on vähintään %lld esinettä, voi jakaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les niveaux d’au moins %lld éléments peuvent être partagés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ %lld+ आइटम वाले स्टेज शेयर हो सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Možeš dijeliti samo etape s barem %lld izrezaka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak legalább %lld elemes pálya osztható meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya stage dengan %lld+ item yang bisa dibagikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi condividere solo scenari con almeno %lld ritagli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有できるのは素材が%lld個以上のステージです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소재가 %lld개 이상인 스테이지만 공유할 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya pentas dengan %lld+ item boleh dikongsi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare baner med minst %lld objekter kan deles."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt alleen levels met minstens %lld uitsneden delen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udostępnić można poziom z co najmniej %lld przedmiotami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só é possível compartilhar fases com %lld recortes ou mais."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só é possível partilhar fases com %lld recortes ou mais."
          }
        },
