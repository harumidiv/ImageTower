    "1つのステージに追加できる素材は最大%lld個です。": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pots afegir fins a %lld retalls per pantalla."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Do úrovně můžeš přidat max. %lld předmětů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En bane kan højst have %lld objekter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Level kann höchstens %lld Elemente haben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείς να προσθέσεις έως %lld κομμάτια σε κάθε πίστα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A stage can have up to %lld items."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un escenario puede tener hasta %lld recortes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kentässä voi olla enintään %lld esinettä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un niveau peut contenir jusqu’à %lld éléments."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक स्टेज में अधिकतम %lld आइटम जोड़ सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "U jednu etapu možeš dodati najviše %lld izrezaka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy pályán legfeljebb %lld elem lehet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksimal %lld item per stage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi aggiungere fino a %lld ritagli per scenario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1つのステージに追加できる素材は最大%lld個です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 스테이지에 소재는 최대 %lld개까지 추가할 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksimum %lld item bagi setiap pentas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En bane kan ha maks %lld objekter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een level kan maximaal %lld uitsneden bevatten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do poziomu możesz dodać maks. %lld przedmiotów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada fase pode ter até %lld recortes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada fase pode ter até %lld recortes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poți adăuga maximum %lld piese într-o etapă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В уровень можно добавить не больше %lld предметов."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Do úrovne môžeš pridať max. %lld predmetov."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En bana kan ha högst %lld objekt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มไอเท็มได้สูงสุด %lld ชิ้นต่อด่าน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir bölüme en fazla %lld parça eklenebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До рівня можна додати не більше %lld предметів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi màn chỉ thêm được tối đa %lld món."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個關卡最多可加入 %lld 個素材。"
          }
        }
