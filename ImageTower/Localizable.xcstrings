          "stringUnit": {
            "state": "translated",
            "value": "Poți partaja doar etape cu minimum %lld piese."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Делиться можно уровнями от %lld предметов."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdieľať sa dajú úrovne s aspoň %lld predmetmi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara banor med minst %lld objekt kan delas."
          }
        },
        "th": {
