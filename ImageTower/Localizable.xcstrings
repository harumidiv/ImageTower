    "受け取れませんでした。時間をおいて、もう一度お試しください。": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'ha pogut rebre. Torna-ho a provar més tard."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přijetí se nezdařilo. Zkus to znovu později."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke modtage. Prøv igen senere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Empfangen fehlgeschlagen. Versuch es später erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η λήψη απέτυχε. Δοκίμασε ξανά αργότερα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't receive. Please try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo recibir. Inténtalo de nuevo más tarde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastaanotto epäonnistui. Yritä myöhemmin uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réception impossible. Réessaie plus tard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्टेज नहीं मिल सका। थोड़ी देर बाद फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Primanje nije uspjelo. Pokušaj ponovno kasnije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült fogadni. Próbáld újra később."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagal menerima. Coba lagi nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile ricevere. Riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受け取れませんでした。時間をおいて、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받지 못했어요. 잠시 후 다시 시도해 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagal menerima. Cuba lagi nanti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke motta. Prøv igjen senere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan niet ontvangen. Probeer het later opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odebrać. Spróbuj ponownie później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível receber. Tente de novo mais tarde."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível receber. Tenta novamente mais tarde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Primirea a eșuat. Încearcă din nou mai târziu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось получить. Попробуй ещё раз позже."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijatie zlyhalo. Skús to znova neskôr."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunde inte ta emot. Försök igen senare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รับไม่ได้ โปรดรอสักครู่แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alınamadı. Biraz sonra yeniden dene."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося отримати. Спробуй ще раз пізніше."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không nhận được. Hãy thử lại sau."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法接收。請稍後再試一次。"
          }
        }
      }
    },
