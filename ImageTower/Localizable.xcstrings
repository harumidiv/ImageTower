    "左右に動かして指を離すと落下・右下で回転": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mou a banda i banda, deixa anar per tirar · Gira a baix a la dreta"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Posuň doleva/doprava a pusť. Otočení vpravo dole"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk til siden, slip for at tabe · drej nederst til højre"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen, loslassen zum Fallenlassen · Drehen unten rechts"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύρε δεξιά-αριστερά, άφησε για πτώση · Περιστροφή κάτω δεξιά"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to move, release to drop · Rotate at bottom right"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve a los lados y suelta para dejar caer · Gira abajo a la derecha"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liikuta sivuille, päästä irti pudottaaksesi · käännä oikealta alhaalta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisse, lâche pour faire tomber · Rotation en bas à droite"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दाएँ-बाएँ खींचें, छोड़ें तो गिरेगा · नीचे दाएँ से घुमाएँ"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomiči lijevo-desno, pusti za ispuštanje · Okreći dolje desno"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd oldalra, engedd el az ejtéshez · forgatás jobbra lent"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Geser kiri-kanan, lepas untuk jatuhkan · Putar di kanan bawah"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta a destra o sinistra e rilascia per far cadere · Ruota in basso a destra"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左右に動かして指を離すと落下・右下で回転"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좌우로 움직이고 손을 떼면 낙하 · 오른쪽 아래로 회전"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret kiri-kanan, lepas untuk jatuhkan · Putar di kanan bawah"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra sideveis, slipp for å slippe ned · roter nede til høyre"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schuif heen en weer en laat los om te laten vallen · Draai rechtsonder"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń w lewo/prawo i puść, by upuścić. Obrót – w prawym dolnym rogu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mova para os lados e solte para derrubar · Gire no canto inferior direito"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Move para os lados e larga para deixar cair · Roda no canto inferior direito"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mișcă stânga-dreapta, ridică degetul ca să cadă · Rotește din dreapta jos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Двигай влево-вправо, отпусти — упадёт. Поворот — справа внизу"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Posuň doľava/doprava a pusti. Otočenie vpravo dole"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra i sidled, släpp för att tappa · vrid nere till höger"
          }
        },
        "th": {
          "stringUnit": {
