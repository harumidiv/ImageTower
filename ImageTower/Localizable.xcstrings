        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося поширити. Спробуй ще раз пізніше."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không chia sẻ được. Hãy thử lại sau."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法分享。請稍後再試一次。"
