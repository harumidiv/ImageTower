    "保存済みの切り抜き素材は削除されないため、別のステージで引き続き使えます。": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els retalls desats no s'eliminen, així que els pots continuar fent servir en altres pantalles."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložené výřezy se nesmažou — můžeš je dál používat v jiných úrovních."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemte udklip slettes ikke og kan bruges i andre baner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesicherte Ausschnitte werden nicht gelöscht – du kannst sie in anderen Levels weiter nutzen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα αποθηκευμένα κομμάτια δεν διαγράφονται, οπότε μπορείς να τα χρησιμοποιείς σε άλλες πίστες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved cutouts won't be deleted, so you can keep using them in other stages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recortes guardados no se eliminan, así que puedes seguir usándolos en otros escenarios."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennettuja leikkeitä ei poisteta, joten voit käyttää niitä muissa kentissä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les détourages enregistrés ne sont pas supprimés : tu peux les réutiliser dans d’autres niveaux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजे गए कटआउट डिलीट नहीं होते, इसलिए दूसरे स्टेज में इस्तेमाल होते रहेंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spremljeni izresci se ne brišu, pa ih i dalje možeš koristiti u drugim etapama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mentett kivágások nem törlődnek, más pályákon is használhatod őket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Potongan tersimpan tidak ikut dihapus, jadi tetap bisa dipakai di stage lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I ritagli salvati non vengono eliminati, quindi puoi continuare a usarli in altri scenari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みの切り抜き素材は削除されないため、別のステージで引き続き使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 소재는 삭제되지 않으니 다른 스테이지에서 계속 쓸 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Keratan yang disimpan tidak dipadam, jadi masih boleh digunakan dalam pentas lain."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagrede utklipp slettes ikke og kan brukes i andre baner."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaarde uitsneden worden niet verwijderd, dus je kunt ze in andere levels blijven gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisane wycinki nie zostaną usunięte — możesz ich używać w innych poziomach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os recortes salvos não serão apagados, então você pode continuar usando em outras fases."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os recortes guardados não são apagados, por isso podes continuar a usá-los noutras fases."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Decupajele salvate nu se șterg, așa că le poți folosi în continuare în alte etape."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранённые вырезки не удалятся — их можно использовать в других уровнях."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložené výrezy sa nevymažú — môžeš ich ďalej používať v iných úrovniach."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparade utklipp raderas inte och kan användas i andra banor."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไอเท็มไดคัทที่บันทึกไว้จะไม่ถูกลบ จึงยังใช้ในด่านอื่นได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı parçalar silinmez; diğer bölümlerde kullanmaya devam edebilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережені вирізки не видаляться — їх можна використовувати в інших рівнях."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hình cắt đã lưu không bị xóa, nên vẫn dùng được ở màn khác."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存的去背素材不會被刪除，可繼續用於其他關卡。"
          }
        }
      }
    },
    "保存済みステージを読み込めませんでした。": {
      "localizations": {
