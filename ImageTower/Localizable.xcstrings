          "stringUnit": {
            "state": "translated",
            "value": "Foto %lld, non ritagliabile"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld枚目、切り抜きできません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld번째 사진, 오려낼 수 없음"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto %lld, tidak boleh dikerat"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilde %lld, kan ikke klippes ut"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto %lld, kan niet worden uitgesneden"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcie %lld, nie można wyciąć"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto %lld, não dá para recortar"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto %lld, não é possível recortar"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poza %lld, nu se poate decupa"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото %lld, вырезать нельзя"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotka %lld, nedá sa vystrihnúť"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bild %lld, kan inte klippas ut"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปที่ %lld, ไดคัทไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf %lld, kesilemiyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото %lld, вирізати не можна"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh %lld, không cắt được"
          }
        },
        "zh-Hant": {
