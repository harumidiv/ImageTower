    "光ったら、指を離さず下へ運びます": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan brilli, arrossega'l avall sense aixecar el dit"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Až se rozzáří, táhni dolů bez puštění"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når det lyser, træk ned uden at give slip"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn es leuchtet, ohne Loslassen nach unten ziehen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν λάμψει, σύρ' το κάτω χωρίς να σηκώσεις το δάχτυλο"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When it glows, drag it down without letting go"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando brille, arrástralo abajo sin soltar"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun kohde hehkuu, vedä alas irrottamatta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand il brille, glisse-le vers le bas sans lâcher"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चमकने पर, उंगली उठाए बिना नीचे खींचें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad zasvijetli, povuci ga dolje bez puštanja prsta"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha felvillan, húzd le elengedés nélkül"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat bersinar, seret ke bawah tanpa melepas jari"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando si illumina, trascinalo giù senza staccare il dito"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "光ったら、指を離さず下へ運びます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빛나면 손을 떼지 말고 아래로 끌어요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apabila bercahaya, seret ke bawah tanpa melepaskan jari"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når det lyser, dra ned uten å slippe"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als het oplicht, sleep je het omlaag zonder los te laten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy zabłyśnie, przeciągnij w dół, nie puszczając"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando brilhar, arraste para baixo sem soltar"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando brilhar, arrasta para baixo sem largar"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când strălucește, trage-l în jos fără să ridici degetul"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда засветится, тяни вниз, не отпуская"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď sa rozžiari, ťahaj nadol bez pustenia"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När det lyser, dra nedåt utan att släppa"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเรืองแสง ลากลงมาโดยไม่ปล่อยนิ้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parlayınca parmağını kaldırmadan aşağı sürükle"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли засвітиться, тягни вниз, не відпускаючи"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi phát sáng, kéo xuống mà không nhấc tay"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "發光後，手指不要放開，往下拖曳"
          }
        }
      }
    },
    "共有したときに表示されたコードを入力してください。メッセージをそのまま貼り付けても大丈夫です。": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdueix el codi que va aparèixer en compartir. També pots enganxar el missatge sencer."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadej kód zobrazený při sdílení. Klidně vlož celou zprávu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast koden, der blev vist ved deling. Du kan også indsætte hele beskeden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib den Code ein, der beim Teilen angezeigt wurde. Du kannst auch die ganze Nachricht einfügen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βάλε τον κωδικό που εμφανίστηκε στην κοινή χρήση. Μπορείς να επικολλήσεις και όλο το μήνυμα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the code shown when the stage was shared. Pasting the whole message works too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce el código que apareció al compartir. También puedes pegar el mensaje completo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Syötä jaettaessa näkynyt koodi. Voit myös liittää koko viestin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisis le code affiché lors du partage. Tu peux aussi coller le message entier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शेयर करते समय दिखा कोड डालें। पूरा मैसेज पेस्ट करना भी ठीक है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Unesi kod prikazan pri dijeljenju. Možeš zalijepiti i cijelu poruku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Add meg a megosztáskor kapott kódot. Az egész üzenetet is beillesztheted."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan kode yang muncul saat berbagi. Tempel seluruh pesannya juga boleh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci il codice mostrato durante la condivisione. Puoi anche incollare l'intero messaggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有したときに表示されたコードを入力してください。メッセージをそのまま貼り付けても大丈夫です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유할 때 표시된 코드를 입력하세요. 메시지를 그대로 붙여 넣어도 괜찮아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan kod yang dipaparkan semasa berkongsi. Tampal seluruh mesej pun boleh."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn koden som ble vist ved deling. Du kan også lime inn hele meldingen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer de code in die bij het delen werd getoond. Je kunt ook het hele bericht plakken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz kod, który pojawił się przy udostępnianiu. Możesz też wkleić całą wiadomość."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite o código exibido ao compartilhar. Você também pode colar a mensagem inteira."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduz o código apresentado ao partilhar. Também podes colar a mensagem completa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdu codul afișat la partajare. Poți lipi și tot mesajul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введи код, полученный при отправке. Можно вставить сообщение целиком."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadaj kód zobrazený pri zdieľaní. Pokojne vlož celú správu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange koden som visades vid delningen. Du kan också klistra in hela meddelandet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใส่รหัสที่แสดงตอนแชร์ จะวางข้อความทั้งหมดเลยก็ได้นะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşırken gösterilen kodu gir. Mesajın tamamını yapıştırabilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введи код, отриманий під час поширення. Можна вставити повідомлення повністю."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập mã hiện ra khi chia sẻ. Dán nguyên tin nhắn cũng được."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入分享時顯示的代碼。直接貼上整段訊息也沒問題。"
          }
        }
      }
    },
    "共有するにはiCloudへのサインインが必要です。設定アプリの一番上からApple アカウントでサインインしてください。": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per compartir, has d'iniciar sessió a iCloud. Inicia sessió amb el compte d'Apple a la part superior de Configuració."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro sdílení se přihlas k iCloudu. Otevři Nastavení a nahoře se přihlas svým Apple účtem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du skal logge ind på iCloud for at dele. Log ind med din Apple-konto øverst i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Teilen musst du bei iCloud angemeldet sein. Öffne „Einstellungen“ und melde dich oben mit deinem Apple Account an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για κοινή χρήση πρέπει να συνδεθείς στο iCloud. Συνδέσου με τον Λογαριασμό Apple στο πάνω μέρος των Ρυθμίσεων."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to iCloud to share. Open Settings and sign in with your Apple Account at the top."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para compartir, inicia sesión en iCloud. Abre Ajustes e inicia sesión con tu Cuenta de Apple en la parte superior."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jakaminen vaatii iCloud-kirjautumisen. Kirjaudu Apple-tilillä Asetusten yläosasta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecte-toi à iCloud pour partager. Ouvre Réglages et connecte-toi avec ton compte Apple tout en haut."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शेयर करने के लिए iCloud में साइन इन ज़रूरी है। सेटिंग्ज़ में सबसे ऊपर से Apple खाते से साइन इन करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za dijeljenje se moraš prijaviti na iCloud. Prijavi se Apple računom na vrhu Postavki."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A megosztáshoz be kell jelentkezned az iCloudba. Jelentkezz be Apple-fiókoddal a Beállítások tetején."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perlu masuk ke iCloud untuk berbagi. Buka Pengaturan dan masuk dengan Akun Apple di bagian paling atas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per condividere devi accedere a iCloud. Apri Impostazioni e accedi con il tuo Account Apple in alto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有するにはiCloudへのサインインが必要です。設定アプリの一番上からApple アカウントでサインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유하려면 iCloud에 로그인해야 해요. 설정 앱 맨 위에서 Apple 계정으로 로그인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perlu daftar masuk ke iCloud untuk berkongsi. Buka Seting dan daftar masuk dengan Akaun Apple di bahagian paling atas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du må logge på iCloud for å dele. Logg på med Apple-kontoen din øverst i Innstillinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log in bij iCloud om te delen. Open Instellingen en log bovenaan in met je Apple Account."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby udostępniać, zaloguj się do iCloud. Otwórz Ustawienia i zaloguj się na Konto Apple na samej górze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para compartilhar, é preciso iniciar sessão no iCloud. Abra Ajustes e inicie sessão com sua Conta Apple no topo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para partilhar, tens de iniciar sessão no iCloud. Abre Definições e inicia sessão com a tua Conta Apple no topo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru partajare trebuie să fii conectat la iCloud. Conectează-te cu contul Apple din partea de sus a Configurărilor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы делиться, войди в iCloud. Открой «Настройки» и войди в Аккаунт Apple вверху экрана."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na zdieľanie sa prihlás do iCloudu. Otvor Nastavenia a hore sa prihlás svojím Apple účtom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du måste logga in på iCloud för att dela. Logga in med ditt Apple-konto högst upp i Inställningar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องลงชื่อเข้า iCloud เพื่อแชร์ ไปที่ด้านบนสุดของแอปการตั้งค่าแล้วลงชื่อเข้าด้วยบัญชี Apple"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşmak için iCloud'a giriş yapmalısın. Ayarlar'ın en üstünden Apple Hesabı'nla giriş yap."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб поширювати, увійди в iCloud. Відкрий «Параметри» та увійди в обліковий запис Apple угорі екрана."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần đăng nhập iCloud để chia sẻ. Mở Cài đặt và đăng nhập Tài khoản Apple ở trên cùng."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分享需要登入 iCloud。請在「設定」App 最上方以 Apple 帳號登入。"
          }
        }
      }
    },
    "共有できませんでした。時間をおいて、もう一度お試しください。": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'ha pogut compartir. Torna-ho a provar més tard."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sdílení se nezdařilo. Zkus to znovu později."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke dele. Prøv igen senere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teilen fehlgeschlagen. Versuch es später erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η κοινή χρήση απέτυχε. Δοκίμασε ξανά αργότερα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't share. Please try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo compartir. Inténtalo de nuevo más tarde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jakaminen epäonnistui. Yritä myöhemmin uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partage impossible. Réessaie plus tard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शेयर नहीं हो सका। थोड़ी देर बाद फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dijeljenje nije uspjelo. Pokušaj ponovno kasnije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült megosztani. Próbáld újra később."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagal berbagi. Coba lagi nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile condividere. Riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有できませんでした。時間をおいて、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유하지 못했어요. 잠시 후 다시 시도해 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagal berkongsi. Cuba lagi nanti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke dele. Prøv igjen senere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan niet delen. Probeer het later opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się udostępnić. Spróbuj ponownie później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível compartilhar. Tente de novo mais tarde."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível partilhar. Tenta novamente mais tarde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Partajarea a eșuat. Încearcă din nou mai târziu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось поделиться. Попробуй ещё раз позже."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdieľanie zlyhalo. Skús to znova neskôr."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunde inte dela. Försök igen senare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แชร์ไม่ได้ โปรดรอสักครู่แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşılamadı. Biraz sonra yeniden dene."
