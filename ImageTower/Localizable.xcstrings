    "ステージには切り抜き素材を1個以上追加してください。": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Afegeix almenys un retall a la pantalla."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidej do úrovně aspoň jeden předmět."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj mindst ét udklip til banen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge dem Level mindestens einen Ausschnitt hinzu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πρόσθεσε τουλάχιστον ένα κομμάτι στην πίστα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add at least one cutout to the stage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade al menos 1 recorte al escenario."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää kenttään vähintään yksi leike."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute au moins un détourage au niveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्टेज में कम से कम 1 कटआउट जोड़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj barem jedan izrezak u etapu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj legalább egy kivágást a pályához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan minimal 1 potongan ke stage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi almeno 1 ritaglio allo scenario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステージには切り抜き素材を1個以上追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스테이지에 오려낸 소재를 1개 이상 추가해 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah sekurang-kurangnya 1 keratan ke pentas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til minst ett utklipp i banen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg minstens 1 uitsnede toe aan het level."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj do poziomu co najmniej jeden przedmiot."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione pelo menos 1 recorte à fase."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona pelo menos 1 recorte à fase."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă cel puțin o piesă în etapă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавь в уровень хотя бы один предмет."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridaj do úrovne aspoň jeden predmet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till minst ett utklipp i banan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรดเพิ่มไอเท็มไดคัทในด่านอย่างน้อย 1 ชิ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bölüme en az 1 parça ekle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додай до рівня хоча б один предмет."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy thêm ít nhất 1 hình cắt vào màn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在關卡中加入至少 1 個去背素材。"
          }
        }
      }
