    "被写体が見つからないため、この写真は切り抜きできません": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'ha trobat cap subjecte, així que no es pot retallar aquesta foto"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na fotce nebyl nalezen objekt — nelze vyříznout"
          }
