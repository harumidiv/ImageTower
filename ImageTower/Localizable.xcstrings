    "%@で使われています。削除するとこれらのステージから外れます。": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S'utilitza a %@. Si l'elimines, es traurà d'aquestes pantalles."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použito v: %@. Po smazání z těchto úrovní zmizí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruges i %@. Sletter du det, fjernes det fra de baner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird in %@ verwendet. Beim Löschen wird es aus diesen Levels entfernt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιείται σε: %@. Αν το διαγράψεις, θα αφαιρεθεί από αυτές τις πίστες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used in %@. Deleting it removes it from these stages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa en %@. Si lo eliminas, se quitará de esos escenarios."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytössä: %@. Jos poistat sen, se poistuu näistä kentistä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé dans %@. Le supprimer le retirera de ces niveaux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ में उपयोग हो रहा है। डिलीट करने पर यह इन स्टेज से हट जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristi se u: %@. Ako ga izbrišeš, uklonit će se iz tih etapa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Használatban: %@. Ha törlöd, kikerül ezekből a pályákból."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipakai di %@. Jika dihapus, item ini akan dikeluarkan dari stage tersebut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usato in %@. Se lo elimini, verrà tolto da questi scenari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@で使われています。削除するとこれらのステージから外れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 사용 중이에요. 삭제하면 이 스테이지에서 빠져요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Digunakan dalam %@. Jika dipadam, item ini akan dikeluarkan daripada pentas tersebut."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Brukes i %@. Sletter du det, fjernes det fra disse banene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruikt in %@. Als je dit verwijdert, wordt het uit deze levels gehaald."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używany w: %@. Po usunięciu zniknie z tych poziomów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado em %@. Se você apagar, ele sairá dessas fases."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado em %@. Se o apagares, será retirado dessas fases."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosită în %@. Dacă o ștergi, va fi scoasă din aceste etape."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется в: %@. После удаления пропадёт из этих уровней."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Použité v: %@. Po vymazaní z týchto úrovní zmizne."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Används i %@. Raderar du den tas den bort från de banorna."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้อยู่ใน %@ หากลบ จะถูกนำออกจากด่านเหล่านี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanıldığı bölümler: %@. Silersen bu bölümlerden çıkarılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовується в: %@. Після видалення зникне з цих рівнів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang dùng trong %@. Nếu xóa, món này sẽ bị gỡ khỏi các màn đó."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在使用。刪除後會從這些關卡中移除。"
          }
        }
      }
    },
    "%@は素材が%lld個未満になり、遊べなくなります。": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "A %@ quedaran menys de %lld retalls i no s'hi podrà jugar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bude mít méně než %lld předmětů — nepůjde hrát."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ får færre end %lld objekter og kan ikke spilles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat dann weniger als %lld Elemente und ist nicht mehr spielbar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι πίστες %@ θα έχουν λιγότερα από %lld κομμάτια και δεν θα παίζονται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will have fewer than %lld items and can't be played."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ quedará con menos de %lld recortes y no se podrá jugar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kentissä %@ on sen jälkeen alle %lld esinettä, eikä niitä voi pelata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aura moins de %lld éléments et ne sera plus jouable."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ में %lld से कम आइटम रह जाएँगे और इसे खेला नहीं जा सकेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "U etapama %@ ostat će manje od %lld izrezaka i neće se moći igrati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: kevesebb mint %lld elem marad, így nem játszható."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ akan punya kurang dari %lld item dan tidak bisa dimainkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ avrà meno di %lld ritagli e non sarà più giocabile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は素材が%lld個未満になり、遊べなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 소재가 %lld개 미만이 되어 플레이할 수 없게 돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ akan ada kurang daripada %lld item dan tidak boleh dimainkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ får færre enn %lld objekter og kan ikke spilles."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ krijgt minder dan %lld uitsneden en is dan niet meer speelbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W %@ będzie mniej niż %lld przedmiotów — nie da się grać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ficará com menos de %lld recortes e não poderá ser jogada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ficará com menos de %lld recortes e deixará de dar para jogar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În %@ vor rămâne sub %lld piese și nu se va mai putea juca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В %@ станет меньше %lld предметов — играть будет нельзя."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bude mať menej ako %lld predmetov — nepôjde hrať."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ får färre än %lld objekt och går inte att spela."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ จะมีไอเท็มน้อยกว่า %lld ชิ้นและเล่นไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu bölümlerde %2$lld parçadan az kalır ve oynanamaz: %1$@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У %@ стане менше ніж %lld предметів — грати буде неможливо."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sẽ còn ít hơn %lld món và không chơi được nữa."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的素材將少於 %lld 個，無法遊玩。"
          }
        }
      }
    },
